# Linger sunucusu — ortam degiskenleri.
#
# Railway'de bunlar "Variables" sekmesine girilir. Bu dosya YALNIZCA ornek;
# gercek degerleri buraya YAZMA, `.env` git'e girmiyor ama bu dosya giriyor.

# ── zorunlu ──────────────────────────────────────────────────────

# Sunucunun herkese acik alan adi. Giris mesaji (SIWS) buna gore uretilir ve
# cuzdan kullaniciya "<alan adi> giris istiyor" der; yanlissa kullanici
# kafasi karisir. Basinda https:// YOK.
LINGER_HOME_DOMAIN=lingerserver-production.up.railway.app

# IP hash'leme tuzu. Uretimde ZORUNLU — yoksa sunucu acilmaz. Rastgele ve gizli. Degistirilirse eski hash'ler
# eslesmez — fraud kurallari gecmisi kaybeder.
LINGER_IP_SALT=

# ── ag ───────────────────────────────────────────────────────────

# `devnet` (varsayilan) veya `mainnet`. Yanlis yazim sessizce devnet'e
# DUSMEZ; sunucu hic acilmaz.
# LINGER_NETWORK=devnet

# RPC adresi. Bos birakilirsa herkese acik RPC kullanilir; uretimde hiz
# siniri yuzunden ozel bir saglayici (Helius, Triton, QuickNode...) sart.
# LINGER_RPC=https://api.devnet.solana.com

# USDC mint'i. Bos birakilirsa Circle'in secilen agdaki USDC'si kullanilir.
# Kendi token'ini KOYMA: ayni adi tasiyan farkli mint'ler farkli varliktir.
# LINGER_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ── odeme (bunlar olmadan odeme KAPALI kalir) ────────────────────

# Sicak cuzdanin gizli anahtari: base58 (64 bayt) veya `solana-keygen` JSON
# dizisi. Odemeler ve hazine buradan yonetilir.
# Icinde ihtiyacin kadar USDC ve islem ucreti + alici hesap kirasi icin SOL
# olmali (en az 0.05 SOL — altina inince odeme durur). Uret:
#   solana-keygen new --outfile hot.json --no-bip39-passphrase
LINGER_HOT_SECRET=

# Kalici depolama. Railway'de bir Volume olusturup `/data`'ya baglayin.
# TANIMSIZ birakilirsa her sey BELLEKTE kalir ve her deploy'da bakiyeler
# silinir — sunucu acilista bunu gurultuyle uyarir.
LINGER_DB=/data/linger.db

# Platform paneli (`/v1/admin/*`) icin paylasilan sir. Cuzdan tabanli giris
# akisina girmiyor — ortada "admin cuzdani" diye bir kimlik yok, tipki
# LINGER_HOT_SECRET gibi tek bir kisi (platform operatoru) kullaniyor.
# TANIMSIZ birakilirsa /v1/admin/* uclari hic acilmaz. Uret:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
LINGER_ADMIN_SECRET=

# ── istege bagli ─────────────────────────────────────────────────

# LINGER_DEPOSIT_INTERVAL_MS=20000     # yatirma taramasi araligi
# LINGER_PENDING_MS=86400000           # dogrulama bekleme suresi. Uretimde varsayilan 24 saat,
#                                     # mainnet'te 1 saatin altindaki deger sunucuyu ACMAZ; devnet
#                                     # demoda kisaltilabilir (orn. 30000). Gelistirmede 30 sn.
# LINGER_MIN_CLIENT_VERSION=0.1.13     # ADR-016 surum kapisi; altindaki istemciler reddedilir
# LINGER_RECONCILE_MS=60000            # asili cekimlerin zincirle mutabakat araligi
# LINGER_WALLET_HOLD_MS=259200000      # cuzdan degisikligi sonrasi bekleme (72 saat)
